# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Solana devnet RPC endpoint. The public one is fine for a demo.
RPC_URL=https://api.devnet.solana.com

# The tea stall's wallet public key (base58). Payments must land here.
# Get one with `npm run setup`, or paste your Phantom (devnet) address.
MERCHANT_PUBKEY=

# Devnet USDC mint (6 decimals), verified via Circle docs.
# If the devnet USDC faucet is dry, self-mint a 6-decimal SPL token and put its
# mint address here instead (see README).
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Price of one cup of chiya, in whole USDC (e.g. 0.10 = ten cents).
PRICE_USDC=0.10

# Price of one cup of chiya in whole SOL (the shop also accepts native SOL).
PRICE_SOL=0.001

# Port the shop server listens on.
PORT=3000

# --- Optional: agent-door client (`npm run agent`) ---
# Which currency the agent pays in: usdc (default) or sol.
AGENT_CURRENCY=usdc
# Where the agent's payer keypair lives (auto-created, gitignored).
AGENT_KEYPAIR=./agent.keypair.json
# Shop base URL the agent calls (defaults to http://localhost:$PORT).
SHOP_URL=http://localhost:3000
